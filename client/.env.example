# Local development: leave unset - the Vite dev server proxies /api to http://localhost:5000.
# Production (Vercel): the full URL of the deployed API project, ending in /api.
VITE_API_URL=https://your-api-project.vercel.app/api

# Optional: force real-time sockets on or off. Defaults to on in development and off in production,
# where the app polls every 30 seconds instead (Vercel cannot hold socket connections open).
# VITE_REALTIME=false
