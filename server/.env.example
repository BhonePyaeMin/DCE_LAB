PORT=5000
NODE_ENV=development

# Leave empty in development to use an embedded MongoDB (data is kept in server/.mongo-data).
# Required in production.
MONGODB_URI=

# Required in production. Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Browser origin(s) allowed to call the API, comma separated. Production: your website URL.
CLIENT_URL=http://localhost:5173

# Optional: store uploads on Cloudinary instead of server/uploads.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional: public API origin prefixed to local upload URLs (needed when the API and client are on different origins).
SERVER_URL=

# Production on Vercel: secret for the daily cron job (Vercel Cron sends it automatically).
CRON_SECRET=

# Optional: public DNS servers if mongodb+srv:// lookups fail on your network.
# DNS_SERVERS=8.8.8.8,1.1.1.1
